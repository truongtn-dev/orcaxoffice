# Copy this file to the repository root as .env and set a database password.
# Never commit .env. The application refuses to start when a required value is missing.

NODE_ENV=development
API_PORT=3001
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:3000

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=orcax
DATABASE_PASSWORD=
DATABASE_NAME=orcax_office
DATABASE_SSL=false

# At least 32 characters. Generate a unique value per environment.
AUTH_TOKEN_SECRET=
AUTH_ACCESS_TTL_SECONDS=900
AUTH_SESSION_TTL_DAYS=14
EMAIL_TRANSPORT=log
EMAIL_FROM=noreply@localhost
# At least 16 characters. Used to authenticate mock payment webhooks.
PAYMENT_WEBHOOK_SECRET=
NEXT_PUBLIC_API_ORIGIN=http://localhost:3001
