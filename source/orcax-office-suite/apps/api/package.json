  "devDependencies": {
    "@nestjs/cli": "12.0.13",
    "@nestjs/schematics": "12.0.13",
    "@nestjs/testing": "12.5.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/supertest": "7.2.1",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.2",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
